# Copy this file to smart-entry.env and fill in your values.
# smart-entry.env is ignored by git.

# PostgreSQL database
SMART_ENTRY_DB_NAME=face-reco
SMART_ENTRY_DB_USER=postgres
SMART_ENTRY_DB_PASSWORD=your-password
SMART_ENTRY_DB_HOST=localhost
SMART_ENTRY_DB_PORT=5432

# Network camera. Leave empty to use the local webcam.
SMART_ENTRY_RTSP_URL=
